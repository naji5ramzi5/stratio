# StratoCrypto — server environment template
# Copy this file to  crypto/.env  on the Hostinger server and fill the values.
# Never commit the real .env to git.

# ── Telegram tokens (one per bot) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
TELEGRAM_PREDICTION_TOKEN=
TELEGRAM_LIQUIDITY_TOKEN=
TELEGRAM_PREDICTOR_TOKEN=
BOT4_TOKEN=

# ── Binance (public data works without keys; keys only for account endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── News ────────────────────────────────────────────────────────────────────
NEWS_API_KEY=

# ── Server tuning ───────────────────────────────────────────────────────────
# Keep foundation models OFF on a small VPS: Chronos/TimesFM download
# hundreds of MB, need torch, and make every prediction ~80s on CPU.
FOUNDATION_MODELS=0

# Minimum 24h quote volume (USDT) to include a symbol
MIN_24H_VOLUME_USDT=5000000

# Report coins whose predicted move is >= this %
PREDICTION_INCREASE_THRESHOLD=3

# Seconds between full scan cycles (the code reads SCAN_INTERVAL_MINUTES=20;
# leave this commented unless you also change the constant)
# SCAN_INTERVAL_MINUTES=20
